# TELNUSA NMS - Public environment variables
#
# SAFE TO COMMIT. Contains only public build-time configuration.
# Secrets, API keys, tokens and passwords do not belong here.
# Server credentials belong in the backend service's environment, not here.
#
# Copy to .env.local for local development overrides (gitignored).

# Data mode controls which data source the frontend uses:
#   "mock"  - deterministic fixture data; no backend required
#   "real"  - live TELNUSA backend API (production default when unset)
VITE_DATA_MODE=mock

# Backend API base path (default: /api)
# Change only if the Apache ProxyPass location differs.
VITE_API_BASE=/api
