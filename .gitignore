# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- TELNUSA NMS additions ---

# Secrets / environment (never commit real credentials)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*

# Python runtime
__pycache__/
*.py[cod]
backend/.venv/
.venv/
venv/
*.egg-info/

# Local runtime state (regenerable; may hold session and telemetry data)
*.db
*.sqlite
*.sqlite3

# Developer backup artifacts (not source)
*.bak
*.bak2
*.before-*
*.after-*
*.orig
*.rej
*.cache-backup-*

# Captured browser and network evidence (may carry session material)
*.har

# Release archives and checksum sidecars (build outputs)
*.zip
*.zip.*
*.tar.gz
*.tgz
