# TELNUSA NMS backend environment. Do not commit real secrets.

NMS_HOST=127.0.0.1
NMS_PORT=8080
NMS_DB_PATH=/var/lib/telnusa-nms/nms.db
NMS_COOKIE_SECURE=1
NMS_SESSION_TTL=43200
# Set to 1 only when running behind trusted reverse proxy (e.g. Apache mod_proxy / Cloudflare Tunnel)
NMS_TRUST_PROXY=0
NMS_DEBUG_ERRORS=0
NMS_LOGIN_RATE_LIMIT=10/60
NMS_AUTH_PEPPER=

# Bootstrap break-glass admin. Defaults to admin@example.com. No fake default credentials.
# Must set NMS_BOOTSTRAP_ADMIN_PASSWORD to activate. First login requires password change.
NMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
NMS_BOOTSTRAP_ADMIN_PASSWORD=
# Server-side Zabbix only. Browser never sees these.
ZABBIX_URL=
ZABBIX_TOKEN=
ZABBIX_VERIFY_TLS=1
ZABBIX_TIMEOUT=15
ZABBIX_TEMPLATE=
ZABBIX_HOST_GROUP=
ZABBIX_AUTO_CREATE_ITEMS=0
ZABBIX_SENDER_HOST=
ZABBIX_SENDER_PORT=10051
ZABBIX_SENDER_TLS=0
ZABBIX_SENDER_VERIFY_TLS=1
ZABBIX_CA_FILE=
ZABBIX_QUEUE_MAX=1000
ZABBIX_RETRY_MAX=5
ZABBIX_RETRY_BASE_SECONDS=5

# Real Zabbix harness is non-destructive unless explicitly enabled.
ZABBIX_TEST_ALLOW_CREATE=0
ZABBIX_TEST_VERIFY_HISTORY=0

# MQTT collector. Disabled until broker credentials exist.
MQTT_ENABLED=0
MQTT_HOST=
MQTT_PORT=8883
MQTT_TOPIC=entermqtt/mitratel/+/telemetry
MQTT_CLIENT_ID=telnusa-nms-collector
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=1
MQTT_TLS_INSECURE_DEV=0
MQTT_CA_FILE=
MQTT_RECONNECT_MIN_SECONDS=1
MQTT_RECONNECT_MAX_SECONDS=60

FRESHNESS_LIVE_SECONDS=300
FRESHNESS_STALE_SECONDS=900
FUTURE_TOLERANCE_SECONDS=300

# Notification provider placeholders. Disabled until real provider config exists.
EMAIL_PROVIDER=disabled
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=
GMAIL_SENDER_EMAIL=

# Remote Access trusted device mappings (server-side only, no arbitrary browser proxying)
RUT_SSH_HOST=192.168.1.144
RUT_SSH_PORT=22
NMS_RUT_SSH_USER=nms-rut
NMS_RUT_SSH_KEY_PATH=/var/lib/telnusa-nms/id_ed25519_rut906
NMS_RUT_KNOWN_HOSTS_PATH=/var/lib/telnusa-nms/known_hosts
RUT_WEBUI_TARGET_HOST=192.168.10.1
RUT_WEBUI_TARGET_PORT=443
RUT_TUNNEL_IDLE_TIMEOUT_SECONDS=300
RUT_TUNNEL_MAX_FAILURES=5
RUT_TUNNEL_STARTUP_WAIT_SECONDS=3.0
